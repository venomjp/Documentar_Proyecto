#!/bin/bash
# /usr/local/bin/webs-index   (root:root, 755; lo ejecuta webadmin)
# Regenera /srv/webs/sites/index.html. Lo llama deploy-site; también se puede lanzar a mano.
set -euo pipefail
umask 022

SITES=/srv/webs/sites
ICONS="$SITES/_icons"
PAGE_TITLE="Webs estáticas"
FAVICON_REL="assets/myfavicon.png"

mkdir -p "$ICONS"

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

get_title() {
    tr '\n\r' '  ' < "$1" | grep -oiP '<title[^>]*>\K[^<]*' | head -n1 \
        | sed -e 's/^ *//' -e 's/ *$//' || true
}

get_desc() {
    tr '\n\r' '  ' < "$1" | grep -oiP '<meta[^>]*name="description"[^>]*content="\K[^"]*' | head -n1 || true
}

list_sites() {
    find "$SITES" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name '_*' -print0 | sort -z -f
}

COUNT=$(find "$SITES" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name '_*' | wc -l)
NOW=$(date '+%Y-%m-%d %H:%M')

TMP=$(mktemp "$SITES/.index.XXXXXX")
trap 'rm -f -- "$TMP"' EXIT

# ------------------------------------------------------------------ cabecera
cat > "$TMP" <<EOF
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>$PAGE_TITLE</title>
<style>
:root{--bg:#f1f4f5;--card:#fff;--text:#1b2a33;--muted:#64767f;--accent:#1769aa;--line:#dde4e7;--shadow:0 1px 3px rgba(0,0,0,.08)}
@media (prefers-color-scheme:dark){:root{--bg:#10171b;--card:#18222a;--text:#e6edf1;--muted:#8fa1ab;--accent:#5aa9e6;--line:#26333c;--shadow:0 1px 3px rgba(0,0,0,.5)}}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
main{max-width:1100px;margin:0 auto;padding:48px 24px}
header{display:flex;flex-wrap:wrap;gap:16px;align-items:baseline;justify-content:space-between;margin-bottom:28px}
h1{margin:0;font-size:2rem}
.count{color:var(--muted);font-size:.95rem}
#q{width:100%;padding:12px 16px;font-size:1rem;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--text);margin-bottom:24px}
#q:focus{outline:2px solid var(--accent);border-color:transparent}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.card{display:flex;gap:16px;align-items:center;padding:18px;background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);color:inherit;text-decoration:none;transition:transform .12s,border-color .12s}
.card:hover{transform:translateY(-2px);border-color:var(--accent)}
.ico{flex:none;width:56px;height:56px;border-radius:12px;object-fit:contain;background:var(--bg)}
.ph{display:flex;align-items:center;justify-content:center;font-size:1.6rem;font-weight:700;color:var(--accent)}
.txt{min-width:0}
.txt h2{margin:0 0 2px;font-size:1.1rem;color:var(--accent);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.txt p{margin:0 0 4px;color:var(--text);font-size:.92rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.txt small{color:var(--muted);font-size:.8rem}
#none,footer{color:var(--muted);text-align:center;margin-top:32px;font-size:.85rem}
</style>
</head>
<body>
<main>
<header>
<h1>$PAGE_TITLE</h1>
<span class="count">$COUNT sitios</span>
</header>
<input id="q" type="search" placeholder="Buscar sitio..." autofocus>
<div class="grid">
EOF

# ------------------------------------------------------------------ tarjetas
while IFS= read -r -d '' dir; do
    name=$(basename "$dir")
    title=""; desc=""; updated="-"

    if [ -f "$dir/index.html" ]; then
        title=$(get_title "$dir/index.html")
        desc=$(get_desc "$dir/index.html")
        updated=$(date -r "$dir/index.html" +%Y-%m-%d)
    fi
    [ -n "$title" ] || title="$name"

    icon_src="$dir/$FAVICON_REL"
    if [ -f "$icon_src" ]; then
        cp -f -- "$icon_src" "$ICONS/$name.png"
        ver=$(stat -c %Y "$icon_src")
        icon_html="<img class=\"ico\" src=\"/_icons/$name.png?v=$ver\" alt=\"\" loading=\"lazy\">"
    else
        rm -f -- "$ICONS/$name.png"
        letter=$(printf '%s' "$name" | cut -c1 | tr '[:lower:]' '[:upper:]')
        icon_html="<span class=\"ico ph\">$letter</span>"
    fi

    t_esc=$(printf '%s' "$title" | esc)
    d_esc=$(printf '%s' "$desc" | esc)
    q_esc=$(printf '%s %s %s' "$name" "$title" "$desc" | tr '[:upper:]' '[:lower:]' | esc)

    p_html=""
    if [ -n "$d_esc" ]; then p_html="<p>$d_esc</p>"; fi

    printf '<a class="card" href="/%s/" data-q="%s">%s<div class="txt"><h2>%s</h2>%s<small>/%s/ · actualizado %s</small></div></a>\n' \
        "$name" "$q_esc" "$icon_html" "$t_esc" "$p_html" "$name" "$updated" >> "$TMP"
done < <(list_sites)

# Iconos huérfanos (sitios eliminados)
for f in "$ICONS"/*.png; do
    [ -e "$f" ] || continue
    n=$(basename "$f" .png)
    [ -d "$SITES/$n" ] || rm -f -- "$f"
done

# ---------------------------------------------------------------------- pie
cat >> "$TMP" <<EOF
</div>
<p id="none" hidden>Ningún sitio coincide.</p>
<footer>Generado el $NOW</footer>
</main>
<script>
var q=document.getElementById('q'),none=document.getElementById('none'),
cards=Array.prototype.slice.call(document.querySelectorAll('.card'));
q.addEventListener('input',function(){
  var v=q.value.trim().toLowerCase(),n=0;
  cards.forEach(function(c){var m=c.getAttribute('data-q').indexOf(v)!==-1;c.hidden=!m;if(m)n++;});
  none.hidden=n>0;
});
</script>
</body>
</html>
EOF

chmod 644 "$TMP"
mv -f -- "$TMP" "$SITES/index.html"
trap - EXIT
